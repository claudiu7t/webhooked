#!/bin/sh

FRONTEND_DIR="ui"
RUST_DIR="server"

# Get the list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo "No files staged. Skipping format check."
    exit 0
fi

FORMAT_FAILED=0
FILES_TO_ADD=""

# --- 1. Rust Formatting (using cargo fmt) ---
RUST_FILES=$(echo "$STAGED_FILES" | grep '\.rs$')
if [ -n "$RUST_FILES" ]; then
    echo "Formatting Rust files using cargo fmt..."

    # Change directory to the Rust project root
    cd "$RUST_DIR" || {
        echo "Error: Cannot change directory to $RUST_DIR. Check RUST_DIR variable."
        FORMAT_FAILED=1
    }

    # Run 'cargo fmt'
    if [ "$FORMAT_FAILED" -eq 0 ]; then
        cargo fmt || FORMAT_FAILED=1
    fi

    cd .. # Go back to the repository root

    if [ "$FORMAT_FAILED" -eq 0 ]; then
        FILES_TO_ADD="$FILES_TO_ADD $RUST_FILES"
    fi
fi

# --- 2. Frontend Formatting (using npm run format) ---
FRONTEND_FILES=$(echo "$STAGED_FILES" | grep -E '\.(vue|js|jsx|ts|tsx|css|scss|less|json|html|md)$')
if [ -n "$FRONTEND_FILES" ]; then
    echo "Formatting frontend files with 'npm run format'..."

    # Change directory to the frontend project root
    cd "$FRONTEND_DIR" || {
        echo "Error: Cannot change directory to $FRONTEND_DIR. Check FRONTEND_DIR variable."
        FORMAT_FAILED=1
    }

    # Run the npm script, then return to the main directory
    if [ "$FORMAT_FAILED" -eq 0 ]; then
        npm run format || FORMAT_FAILED=1
    fi

    cd .. # Go back to the repository root

    if [ "$FORMAT_FAILED" -eq 0 ]; then
        FILES_TO_ADD="$FILES_TO_ADD $FRONTEND_FILES"
    fi
fi

# --- Finalizing the Commit ---
if [ "$FORMAT_FAILED" -eq 0 ]; then
    echo "Staging formatted changes..."
    # Re-stage all files that were formatted
    echo "$FILES_TO_ADD" | xargs git add

    # Restore unstaged changes
    exit 0
else
    echo "--------------------------------------------------------"
    echo "Formatting failed. Fix files manually and commit again."
    echo "Run 'cargo fmt' and 'npm run format' in the correct directories."
    echo "--------------------------------------------------------"

    # Restore unstaged changes before exiting with failure code
    exit 1
fi